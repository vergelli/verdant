<GuiXml>
  <Controls>

    <!--
      Verdant settings — a proper movable window. Phase 7.1: was a popup
      anchored next to the bar via Lua positioning; now it's a TopLevelControl
      with title, close button, drag handler. Position is persisted in
      SavedVars.settings.{x,y}. Both bar and graph chrome carry a gear
      button that targets this same window.
    -->
    <TopLevelControl name="VerdantSettingsPanel"
                     hidden="true"
                     clampedToScreen="true"
                     movable="true"
                     mouseEnabled="true">

      <Dimensions x="280" y="340"/>

      <OnMoveStop>Verdant.Settings.on_move_stop()</OnMoveStop>

      <Controls>

        <Backdrop name="$(parent)Bg">
          <AnchorFill/>
          <Edge file="EsoUI/Art/Tooltips/UI-Border.dds"
                edgeFileWidth="128" edgeFileHeight="16" edgeSize="6"/>
          <Center file="EsoUI/Art/Tooltips/UI-TooltipCenter.dds"/>
          <Insets left="6" top="6" right="-6" bottom="-6"/>
        </Backdrop>

        <!-- ── title bar ───────────────────────────────────────────────── -->
        <Label name="$(parent)WindowTitle"
               font="ZoFontWindowTitle"
               horizontalAlignment="LEFT"
               verticalAlignment="CENTER">
          <Anchor point="TOPLEFT" offsetX="14" offsetY="10"/>
          <Dimensions y="18"/>
        </Label>

        <Button name="$(parent)CloseBtn" mouseEnabled="true"
                mouseOverBlendMode="ADD" inherits="ZO_ButtonBehaviorClickSound">
          <Anchor point="TOPRIGHT" offsetX="-8" offsetY="8"/>
          <Dimensions x="16" y="16"/>
          <Textures normal="EsoUI/Art/Buttons/decline_up.dds"
                    pressed="EsoUI/Art/Buttons/decline_down.dds"
                    mouseOver="EsoUI/Art/Buttons/decline_over.dds"/>
          <OnClicked>Verdant.Settings.toggle()</OnClicked>
        </Button>

        <!-- ── Row 1: Refresh Rate ─────────────────────────────────────── -->
        <Label name="$(parent)Title"
               font="ZoFontGameSmall"
               horizontalAlignment="LEFT"
               verticalAlignment="CENTER">
          <Anchor point="TOPLEFT" offsetX="14" offsetY="40"/>
          <Dimensions x="160" y="12"/>
        </Label>

        <Label name="$(parent)RateLabel"
               font="ZoFontGameSmall"
               horizontalAlignment="RIGHT"
               verticalAlignment="CENTER">
          <Anchor point="TOPRIGHT" offsetX="-14" offsetY="40"/>
          <Dimensions x="80" y="12"/>
        </Label>

        <Control name="$(parent)SliderTrack" mouseEnabled="true">
          <Anchor point="TOPLEFT"  offsetX="14"  offsetY="55"/>
          <Anchor point="TOPRIGHT" offsetX="-14" offsetY="55"/>
          <Dimensions y="14"/>
          <OnMouseUp>Verdant.Settings.on_rate_track_click(self)</OnMouseUp>
        </Control>

        <!-- ── Row 2: Heal Window ──────────────────────────────────────── -->
        <Label name="$(parent)HealTitle"
               font="ZoFontGameSmall"
               horizontalAlignment="LEFT"
               verticalAlignment="CENTER">
          <Anchor point="TOPLEFT" offsetX="14" offsetY="78"/>
          <Dimensions x="160" y="12"/>
        </Label>

        <Label name="$(parent)HealLabel"
               font="ZoFontGameSmall"
               horizontalAlignment="RIGHT"
               verticalAlignment="CENTER">
          <Anchor point="TOPRIGHT" offsetX="-14" offsetY="78"/>
          <Dimensions x="80" y="12"/>
        </Label>

        <Control name="$(parent)SliderTrackHeal" mouseEnabled="true">
          <Anchor point="TOPLEFT"  offsetX="14"  offsetY="93"/>
          <Anchor point="TOPRIGHT" offsetX="-14" offsetY="93"/>
          <Dimensions y="14"/>
          <OnMouseUp>Verdant.Settings.on_heal_track_click(self)</OnMouseUp>
        </Control>

        <!-- ── Row 3: Shield Window ────────────────────────────────────── -->
        <Label name="$(parent)ShieldTitle"
               font="ZoFontGameSmall"
               horizontalAlignment="LEFT"
               verticalAlignment="CENTER">
          <Anchor point="TOPLEFT" offsetX="14" offsetY="116"/>
          <Dimensions x="160" y="12"/>
        </Label>

        <Label name="$(parent)ShieldLabel"
               font="ZoFontGameSmall"
               horizontalAlignment="RIGHT"
               verticalAlignment="CENTER">
          <Anchor point="TOPRIGHT" offsetX="-14" offsetY="116"/>
          <Dimensions x="80" y="12"/>
        </Label>

        <Control name="$(parent)SliderTrackShield" mouseEnabled="true">
          <Anchor point="TOPLEFT"  offsetX="14"  offsetY="131"/>
          <Anchor point="TOPRIGHT" offsetX="-14" offsetY="131"/>
          <Dimensions y="14"/>
          <OnMouseUp>Verdant.Settings.on_shield_track_click(self)</OnMouseUp>
        </Control>

        <!-- ── Row 4: Sampling Rate ────────────────────────────────────── -->
        <Label name="$(parent)SampleTitle"
               font="ZoFontGameSmall"
               horizontalAlignment="LEFT"
               verticalAlignment="CENTER">
          <Anchor point="TOPLEFT" offsetX="14" offsetY="154"/>
          <Dimensions x="160" y="12"/>
        </Label>

        <Label name="$(parent)SampleLabel"
               font="ZoFontGameSmall"
               horizontalAlignment="RIGHT"
               verticalAlignment="CENTER">
          <Anchor point="TOPRIGHT" offsetX="-14" offsetY="154"/>
          <Dimensions x="80" y="12"/>
        </Label>

        <Control name="$(parent)SliderTrackSample" mouseEnabled="true">
          <Anchor point="TOPLEFT"  offsetX="14"  offsetY="169"/>
          <Anchor point="TOPRIGHT" offsetX="-14" offsetY="169"/>
          <Dimensions y="14"/>
          <OnMouseUp>Verdant.Settings.on_sample_track_click(self)</OnMouseUp>
        </Control>

        <!-- ── Row 5: Time Window ──────────────────────────────────────── -->
        <Label name="$(parent)TWindowTitle"
               font="ZoFontGameSmall"
               horizontalAlignment="LEFT"
               verticalAlignment="CENTER">
          <Anchor point="TOPLEFT" offsetX="14" offsetY="192"/>
          <Dimensions x="160" y="12"/>
        </Label>

        <Label name="$(parent)TWindowLabel"
               font="ZoFontGameSmall"
               horizontalAlignment="RIGHT"
               verticalAlignment="CENTER">
          <Anchor point="TOPRIGHT" offsetX="-14" offsetY="192"/>
          <Dimensions x="80" y="12"/>
        </Label>

        <Control name="$(parent)SliderTrackTWindow" mouseEnabled="true">
          <Anchor point="TOPLEFT"  offsetX="14"  offsetY="207"/>
          <Anchor point="TOPRIGHT" offsetX="-14" offsetY="207"/>
          <Dimensions y="14"/>
          <OnMouseUp>Verdant.Settings.on_twindow_track_click(self)</OnMouseUp>
        </Control>

        <!-- ── Row 6: Viewport Alpha ───────────────────────────────────── -->
        <Label name="$(parent)VPAlphaTitle"
               font="ZoFontGameSmall"
               horizontalAlignment="LEFT"
               verticalAlignment="CENTER">
          <Anchor point="TOPLEFT" offsetX="14" offsetY="230"/>
          <Dimensions x="160" y="12"/>
        </Label>

        <Label name="$(parent)VPAlphaLabel"
               font="ZoFontGameSmall"
               horizontalAlignment="RIGHT"
               verticalAlignment="CENTER">
          <Anchor point="TOPRIGHT" offsetX="-14" offsetY="230"/>
          <Dimensions x="80" y="12"/>
        </Label>

        <Control name="$(parent)SliderTrackVPAlpha" mouseEnabled="true">
          <Anchor point="TOPLEFT"  offsetX="14"  offsetY="245"/>
          <Anchor point="TOPRIGHT" offsetX="-14" offsetY="245"/>
          <Dimensions y="14"/>
          <OnMouseUp>Verdant.Settings.on_vpalpha_track_click(self)</OnMouseUp>
        </Control>

        <!-- ── Row 7: Font Size ────────────────────────────────────────── -->
        <Label name="$(parent)FontTitle"
               font="ZoFontGameSmall"
               horizontalAlignment="LEFT"
               verticalAlignment="CENTER">
          <Anchor point="TOPLEFT" offsetX="14" offsetY="268"/>
          <Dimensions x="160" y="12"/>
        </Label>

        <Label name="$(parent)FontLabel"
               font="ZoFontGameSmall"
               horizontalAlignment="RIGHT"
               verticalAlignment="CENTER">
          <Anchor point="TOPRIGHT" offsetX="-14" offsetY="268"/>
          <Dimensions x="80" y="12"/>
        </Label>

        <Control name="$(parent)SliderTrackFont" mouseEnabled="true">
          <Anchor point="TOPLEFT"  offsetX="14"  offsetY="283"/>
          <Anchor point="TOPRIGHT" offsetX="-14" offsetY="283"/>
          <Dimensions y="14"/>
          <OnMouseUp>Verdant.Settings.on_font_track_click(self)</OnMouseUp>
        </Control>

        <!-- ── Reset to Defaults button ────────────────────────────────── -->
        <Button name="$(parent)ResetBtn"
                mouseEnabled="true"
                font="ZoFontGameSmall"
                inherits="ZO_DefaultButton">
          <Anchor point="BOTTOMLEFT"  offsetX="14"  offsetY="-12"/>
          <Anchor point="BOTTOMRIGHT" offsetX="-14" offsetY="-12"/>
          <Dimensions y="22"/>
          <OnClicked>Verdant.Settings.on_reset_click()</OnClicked>
        </Button>

      </Controls>
    </TopLevelControl>

  </Controls>
</GuiXml>
