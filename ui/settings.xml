<GuiXml>
  <Controls>

    <!--
      Settings drop-down panel.  No anchor here — M.toggle() positions it
      dynamically above or below VerdantBarWindow depending on screen room.
      Not movable: it's a transient popup, not a persistent window.
    -->
    <TopLevelControl name="VerdantSettingsPanel"
                     hidden="true"
                     clampedToScreen="true"
                     mouseEnabled="true">

      <Dimensions x="160" y="210"/>

      <Controls>

        <Backdrop name="$(parent)Bg">
          <AnchorFill/>
          <Edge file="EsoUI/Art/Tooltips/UI-Border.dds"
                edgeFileWidth="128" edgeFileHeight="16" edgeSize="6"/>
          <Center file="EsoUI/Art/Tooltips/UI-TooltipCenter.dds"/>
          <Insets left="6" top="6" right="-6" bottom="-6"/>
        </Backdrop>

        <!-- ── Row 1: Refresh Rate ─────────────────────────────────────── -->
        <Label name="$(parent)Title"
               font="ZoFontGameSmall"
               horizontalAlignment="LEFT"
               verticalAlignment="CENTER">
          <Anchor point="TOPLEFT" offsetX="8" offsetY="7"/>
          <Dimensions x="88" y="12"/>
        </Label>

        <Label name="$(parent)RateLabel"
               font="ZoFontGameSmall"
               horizontalAlignment="RIGHT"
               verticalAlignment="CENTER">
          <Anchor point="TOPRIGHT" offsetX="-8" offsetY="7"/>
          <Dimensions x="54" y="12"/>
        </Label>

        <Control name="$(parent)SliderTrack" mouseEnabled="true">
          <Anchor point="TOPLEFT"  offsetX="8"  offsetY="22"/>
          <Anchor point="TOPRIGHT" offsetX="-8" offsetY="22"/>
          <Dimensions y="14"/>
          <OnMouseUp>Verdant.Settings.on_rate_track_click(self)</OnMouseUp>
        </Control>

        <!-- ── Row 2: Heal Window ──────────────────────────────────────── -->
        <Label name="$(parent)HealTitle"
               font="ZoFontGameSmall"
               horizontalAlignment="LEFT"
               verticalAlignment="CENTER">
          <Anchor point="TOPLEFT" offsetX="8" offsetY="46"/>
          <Dimensions x="88" y="12"/>
        </Label>

        <Label name="$(parent)HealLabel"
               font="ZoFontGameSmall"
               horizontalAlignment="RIGHT"
               verticalAlignment="CENTER">
          <Anchor point="TOPRIGHT" offsetX="-8" offsetY="46"/>
          <Dimensions x="54" y="12"/>
        </Label>

        <Control name="$(parent)SliderTrackHeal" mouseEnabled="true">
          <Anchor point="TOPLEFT"  offsetX="8"  offsetY="61"/>
          <Anchor point="TOPRIGHT" offsetX="-8" offsetY="61"/>
          <Dimensions y="14"/>
          <OnMouseUp>Verdant.Settings.on_heal_track_click(self)</OnMouseUp>
        </Control>

        <!-- ── Row 3: Shield Window ────────────────────────────────────── -->
        <Label name="$(parent)ShieldTitle"
               font="ZoFontGameSmall"
               horizontalAlignment="LEFT"
               verticalAlignment="CENTER">
          <Anchor point="TOPLEFT" offsetX="8" offsetY="89"/>
          <Dimensions x="88" y="12"/>
        </Label>

        <Label name="$(parent)ShieldLabel"
               font="ZoFontGameSmall"
               horizontalAlignment="RIGHT"
               verticalAlignment="CENTER">
          <Anchor point="TOPRIGHT" offsetX="-8" offsetY="89"/>
          <Dimensions x="54" y="12"/>
        </Label>

        <Control name="$(parent)SliderTrackShield" mouseEnabled="true">
          <Anchor point="TOPLEFT"  offsetX="8"  offsetY="104"/>
          <Anchor point="TOPRIGHT" offsetX="-8" offsetY="104"/>
          <Dimensions y="14"/>
          <OnMouseUp>Verdant.Settings.on_shield_track_click(self)</OnMouseUp>
        </Control>

        <!-- ── Row 4: Sampling Rate ────────────────────────────────────── -->
        <Label name="$(parent)SampleTitle"
               font="ZoFontGameSmall"
               horizontalAlignment="LEFT"
               verticalAlignment="CENTER">
          <Anchor point="TOPLEFT" offsetX="8" offsetY="132"/>
          <Dimensions x="88" y="12"/>
        </Label>

        <Label name="$(parent)SampleLabel"
               font="ZoFontGameSmall"
               horizontalAlignment="RIGHT"
               verticalAlignment="CENTER">
          <Anchor point="TOPRIGHT" offsetX="-8" offsetY="132"/>
          <Dimensions x="54" y="12"/>
        </Label>

        <Control name="$(parent)SliderTrackSample" mouseEnabled="true">
          <Anchor point="TOPLEFT"  offsetX="8"  offsetY="147"/>
          <Anchor point="TOPRIGHT" offsetX="-8" offsetY="147"/>
          <Dimensions y="14"/>
          <OnMouseUp>Verdant.Settings.on_sample_track_click(self)</OnMouseUp>
        </Control>

        <!-- ── Row 5: Time Window ──────────────────────────────────────── -->
        <Label name="$(parent)TWindowTitle"
               font="ZoFontGameSmall"
               horizontalAlignment="LEFT"
               verticalAlignment="CENTER">
          <Anchor point="TOPLEFT" offsetX="8" offsetY="172"/>
          <Dimensions x="88" y="12"/>
        </Label>

        <Label name="$(parent)TWindowLabel"
               font="ZoFontGameSmall"
               horizontalAlignment="RIGHT"
               verticalAlignment="CENTER">
          <Anchor point="TOPRIGHT" offsetX="-8" offsetY="172"/>
          <Dimensions x="54" y="12"/>
        </Label>

        <Control name="$(parent)SliderTrackTWindow" mouseEnabled="true">
          <Anchor point="TOPLEFT"  offsetX="8"  offsetY="187"/>
          <Anchor point="TOPRIGHT" offsetX="-8" offsetY="187"/>
          <Dimensions y="14"/>
          <OnMouseUp>Verdant.Settings.on_twindow_track_click(self)</OnMouseUp>
        </Control>

      </Controls>
    </TopLevelControl>

  </Controls>
</GuiXml>
