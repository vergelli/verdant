<GuiXml>
  <Controls>

    <TopLevelControl name="VerdantBarWindow"
                     hidden="true"
                     clampedToScreen="true"
                     movable="true"
                     mouseEnabled="true"
                     resizeHandleSize="8">

      <Anchor point="BOTTOMRIGHT" relativeTo="GuiRoot"
              relativePoint="BOTTOMRIGHT" offsetX="-20" offsetY="-40"/>
      <Dimensions x="70" y="240"/>

      <OnMoveStop>Verdant.Bar.on_move_stop()</OnMoveStop>
      <OnResizeStop>Verdant.Bar.on_resize_stop()</OnResizeStop>

      <Controls>

        <!-- Window chrome -->
        <Backdrop name="$(parent)Bg">
          <AnchorFill/>
          <Edge file="EsoUI/Art/Tooltips/UI-Border.dds"
                edgeFileWidth="128" edgeFileHeight="16" edgeSize="8"/>
          <Center file="EsoUI/Art/Tooltips/UI-TooltipCenter.dds"/>
          <Insets left="8" top="8" right="-8" bottom="-8"/>
        </Backdrop>

        <!-- Addon name — small, centered, top of window -->
        <Label name="$(parent)TitleLabel"
               font="ZoFontGameSmall"
               horizontalAlignment="CENTER"
               verticalAlignment="CENTER">
          <Anchor point="TOPLEFT"  offsetX="8" offsetY="8"/>
          <Anchor point="TOPRIGHT" offsetX="-8" offsetY="8"/>
          <Dimensions y="10"/>
        </Label>

        <!-- Prev arrow -->
        <Label name="$(parent)PrevBtn"
               mouseEnabled="true"
               font="ZoFontGameSmall"
               horizontalAlignment="LEFT"
               verticalAlignment="CENTER">
          <Anchor point="TOPLEFT" offsetX="8" offsetY="20"/>
          <Dimensions x="14" y="14"/>
          <OnMouseUp>Verdant.Bar.prev_metric()</OnMouseUp>
        </Label>

        <!-- Metric acronym -->
        <Label name="$(parent)MetricLabel"
               font="ZoFontGameSmall"
               horizontalAlignment="CENTER"
               verticalAlignment="CENTER">
          <Anchor point="TOPLEFT"  offsetX="24" offsetY="20"/>
          <Anchor point="TOPRIGHT" offsetX="-24" offsetY="20"/>
          <Dimensions y="14"/>
        </Label>

        <!-- Next arrow -->
        <Label name="$(parent)NextBtn"
               mouseEnabled="true"
               font="ZoFontGameSmall"
               horizontalAlignment="RIGHT"
               verticalAlignment="CENTER">
          <Anchor point="TOPRIGHT" offsetX="-8" offsetY="20"/>
          <Dimensions x="14" y="14"/>
          <OnMouseUp>Verdant.Bar.next_metric()</OnMouseUp>
        </Label>

        <!-- Value display (number or %) — leaves right margin for settings + graph btns -->
        <Label name="$(parent)ValueLabel"
               font="ZoFontGameSmall"
               horizontalAlignment="CENTER"
               verticalAlignment="CENTER">
          <Anchor point="TOPLEFT"  offsetX="8"   offsetY="36"/>
          <Anchor point="TOPRIGHT" offsetX="-40" offsetY="36"/>
          <Dimensions y="14"/>
        </Label>

        <!-- Graph window toggle — same row as ValueLabel -->
        <Label name="$(parent)GraphBtn"
               mouseEnabled="true"
               font="ZoFontGameSmall"
               horizontalAlignment="CENTER"
               verticalAlignment="CENTER">
          <Anchor point="TOPRIGHT" offsetX="-22" offsetY="36"/>
          <Dimensions x="16" y="14"/>
          <OnMouseUp>Verdant.Graph.toggle()</OnMouseUp>
        </Label>

        <!-- Settings toggle — gear icon button, same row as ValueLabel -->
        <Button name="$(parent)SettingsBtn"
                mouseEnabled="true"
                mouseOverBlendMode="ADD"
                inherits="ZO_ButtonBehaviorClickSound">
          <Anchor point="TOPRIGHT" offsetX="-2" offsetY="36"/>
          <Dimensions x="18" y="14"/>
          <Textures normal="EsoUI/Art/Quest/map_configure_up.dds"
                    pressed="EsoUI/Art/Quest/map_configure_down.dds"
                    mouseOver="EsoUI/Art/Quest/map_configure_down.dds"/>
          <OnClicked>Verdant.Settings.toggle()</OnClicked>
        </Button>

        <!--
          BarArea: fixed narrow width, centered via TOP/BOTTOM anchors.
          TOP and BOTTOM are center-horizontal points in ESO, so the bar
          is always centered regardless of window width.
          Track and fill textures are created in Lua.
        -->
        <Control name="$(parent)BarArea" mouseEnabled="false">
          <Anchor point="TOP"    offsetY="52"/>
          <Anchor point="BOTTOM" offsetY="-70"/>
          <Dimensions x="22"/>
        </Control>

        <!-- Display mode toggle: % ↔ # — proper button so it looks clickable -->
        <Button name="$(parent)ModeBtn"
                mouseEnabled="true"
                font="ZoFontGameSmall"
                inherits="ZO_DefaultButton">
          <Anchor point="BOTTOMLEFT"  offsetX="6"  offsetY="-41"/>
          <Anchor point="BOTTOMRIGHT" offsetX="-6" offsetY="-41"/>
          <Dimensions y="22"/>
          <OnClicked>Verdant.Bar.toggle_display_mode()</OnClicked>
        </Button>

        <!-- API version (hidden via Lua; kept for reference) -->
        <Label name="$(parent)ApiLabel"
               font="ZoFontGameSmall"
               horizontalAlignment="CENTER"
               verticalAlignment="CENTER">
          <Anchor point="BOTTOMLEFT"  offsetX="4"  offsetY="-23"/>
          <Anchor point="BOTTOMRIGHT" offsetX="-4" offsetY="-23"/>
          <Dimensions y="10"/>
        </Label>

        <!-- Addon + API version, single line -->
        <Label name="$(parent)VersionLabel"
               font="ZoFontGameSmall"
               horizontalAlignment="CENTER"
               verticalAlignment="CENTER">
          <Anchor point="BOTTOMLEFT"  offsetX="4"  offsetY="-13"/>
          <Anchor point="BOTTOMRIGHT" offsetX="-4" offsetY="-13"/>
          <Dimensions y="10"/>
        </Label>

      </Controls>
    </TopLevelControl>

  </Controls>
</GuiXml>
