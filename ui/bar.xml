<GuiXml>
  <Controls>

    <TopLevelControl name="VerdantBarWindow"
                     hidden="true"
                     clampedToScreen="true"
                     movable="true"
                     mouseEnabled="true"
                     resizeHandleSize="8">

      <Anchor point="BOTTOMRIGHT" relativeTo="GuiRoot"
              relativePoint="BOTTOMRIGHT" offsetX="-20" offsetY="-40"/>
      <Dimensions x="70" y="240"/>

      <OnMoveStop>Verdant.Bar.on_move_stop()</OnMoveStop>
      <OnResizeStop>Verdant.Bar.on_resize_stop()</OnResizeStop>

      <Controls>

        <!-- Window chrome -->
        <Backdrop name="$(parent)Bg">
          <AnchorFill/>
          <Edge file="EsoUI/Art/Tooltips/UI-Border.dds"
                edgeFileWidth="128" edgeFileHeight="16" edgeSize="8"/>
          <Center file="EsoUI/Art/Tooltips/UI-TooltipCenter.dds"/>
          <Insets left="8" top="8" right="-8" bottom="-8"/>
        </Backdrop>

        <!-- Prev arrow — Label acts as clickable text; no invisible Button quirks -->
        <Label name="$(parent)PrevBtn"
               mouseEnabled="true"
               font="ZoFontGameSmall"
               horizontalAlignment="LEFT"
               verticalAlignment="CENTER">
          <Anchor point="TOPLEFT" offsetX="8" offsetY="8"/>
          <Dimensions x="14" y="16"/>
          <OnMouseUp>Verdant.Bar.prev_metric()</OnMouseUp>
        </Label>

        <!-- Metric acronym — both TOPLEFT/TOPRIGHT share same offsetY to avoid
             conflicting vertical constraints that caused the collision bug -->
        <Label name="$(parent)MetricLabel"
               font="ZoFontGameSmall"
               horizontalAlignment="CENTER"
               verticalAlignment="CENTER">
          <Anchor point="TOPLEFT"  offsetX="24" offsetY="8"/>
          <Anchor point="TOPRIGHT" offsetX="-24" offsetY="8"/>
          <Dimensions y="16"/>
        </Label>

        <!-- Next arrow -->
        <Label name="$(parent)NextBtn"
               mouseEnabled="true"
               font="ZoFontGameSmall"
               horizontalAlignment="RIGHT"
               verticalAlignment="CENTER">
          <Anchor point="TOPRIGHT" offsetX="-8" offsetY="8"/>
          <Dimensions x="14" y="16"/>
          <OnMouseUp>Verdant.Bar.next_metric()</OnMouseUp>
        </Label>

        <!-- Value display (number or %) — leaves right margin for settings btn -->
        <Label name="$(parent)ValueLabel"
               font="ZoFontGameSmall"
               horizontalAlignment="CENTER"
               verticalAlignment="CENTER">
          <Anchor point="TOPLEFT"  offsetX="8"   offsetY="28"/>
          <Anchor point="TOPRIGHT" offsetX="-22" offsetY="28"/>
          <Dimensions y="14"/>
        </Label>

        <!-- Settings toggle (⚙ gear, top-right of value row) -->
        <Label name="$(parent)SettingsBtn"
               mouseEnabled="true"
               font="ZoFontGameSmall"
               horizontalAlignment="CENTER"
               verticalAlignment="CENTER">
          <Anchor point="TOPRIGHT" offsetX="-2" offsetY="28"/>
          <Dimensions x="18" y="14"/>
          <OnMouseUp>Verdant.Settings.toggle()</OnMouseUp>
        </Label>

        <!--
          BarArea: fixed narrow width, centered via TOP/BOTTOM anchors.
          TOP and BOTTOM are center-horizontal points in ESO, so the bar
          is always centered regardless of window width.
          Track and fill textures are created in Lua.
        -->
        <Control name="$(parent)BarArea" mouseEnabled="false">
          <Anchor point="TOP"    offsetY="46"/>
          <Anchor point="BOTTOM" offsetY="-47"/>
          <Dimensions x="22"/>
        </Control>

        <!--
          Display mode toggle: full-width strip sitting between the ApiLabel
          and the bar area. Both anchors share the same offsetY so the bottom
          edge is unambiguous.  Color and text set each tick in Lua.
        -->
        <Label name="$(parent)ModeBtn"
               mouseEnabled="true"
               font="ZoFontGameSmall"
               horizontalAlignment="CENTER"
               verticalAlignment="CENTER">
          <Anchor point="BOTTOMLEFT"  offsetX="6"  offsetY="-35"/>
          <Anchor point="BOTTOMRIGHT" offsetX="-6" offsetY="-35"/>
          <Dimensions y="10"/>
          <OnMouseUp>Verdant.Bar.toggle_display_mode()</OnMouseUp>
        </Label>

        <!-- API version -->
        <Label name="$(parent)ApiLabel"
               font="ZoFontGameSmall"
               horizontalAlignment="CENTER"
               verticalAlignment="CENTER">
          <Anchor point="BOTTOMLEFT"  offsetX="4"  offsetY="-23"/>
          <Anchor point="BOTTOMRIGHT" offsetX="-4" offsetY="-23"/>
          <Dimensions y="10"/>
        </Label>

        <!-- Addon version (lowest line) -->
        <Label name="$(parent)VersionLabel"
               font="ZoFontGameSmall"
               horizontalAlignment="CENTER"
               verticalAlignment="CENTER">
          <Anchor point="BOTTOMLEFT"  offsetX="4"  offsetY="-11"/>
          <Anchor point="BOTTOMRIGHT" offsetX="-4" offsetY="-11"/>
          <Dimensions y="10"/>
        </Label>

      </Controls>
    </TopLevelControl>

  </Controls>
</GuiXml>
